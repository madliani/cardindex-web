{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["astro/astro-jsx", "astro/client", "react", "react-dom"]
    },
    "extends": "./tsconfig.app.json",
    "include": [
        "${configDir}/.astro/types.d.ts",
        "${configDir}/src/**/*.astro",
        "${configDir}/react/**/*.ts",
        "${configDir}/react/**/*.tsx"
    ]
}
