{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": ["dom", "dom.asynciterable", "dom.iterable"],
        "paths": {
            "@assets/*": ["${configDir}/src/assets/*"],
            "@blocs/*": ["${configDir}/src/blocs/*"],
            "@components/*": ["${configDir}/src/components/*"],
            "@configurations/*": ["${configDir}/src/configurations/*"],
            "@layouts/*": ["${configDir}/src/layouts/*"],
            "@pages/*": ["${configDir}/src/pages/*"],
            "@react/*": ["${configDir}/react/*"],
            "@src/*": ["${configDir}/src/*"]
        },
        "types": ["astro/astro-jsx", "astro/client", "react", "react-dom"]
    },
    "extends": "./tsconfig.base.json",
    "include": [
        "${configDir}/.astro/types.d.ts",
        "${configDir}/src/**/*.astro",
        "${configDir}/react/**/*.ts",
        "${configDir}/react/**/*.tsx"
    ]
}
